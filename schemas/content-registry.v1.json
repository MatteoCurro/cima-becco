{
  "version": 1,
  "purpose": "Cima Becco canonical metadata registry (non-UI, experimental)",
  "rules": {
    "missing": "null, never zero or false",
    "sourceId": "stable internal id independent from slug",
    "licensing": "field-level provenance; photo-level attribution",
    "inferredEquipment": "forbidden",
    "inferredSafety": "forbidden",
    "gradeConversion": "preserve original grade and grading system, derived conversion marked",
    "status": [
      "raw",
      "linked",
      "enriched",
      "editorially_reviewed"
    ],
    "routeTypeDistinction": [
      "single_pitch",
      "multi_pitch",
      "trad",
      "sport",
      "mixed",
      "boulder"
    ],
    "linkedRelations": [
      "located_in",
      "part_of",
      "starts_at",
      "ends_at",
      "passes_near",
      "passes_through",
      "ascends_to",
      "was_opened_by",
      "managed_by",
      "requires_access_through",
      "restricted_by"
    ]
  },
  "fields": {
    "name": {
      "type": "string",
      "required": true,
      "source": "explicit"
    },
    "aliases": {
      "type": "string[]",
      "source": "explicit"
    },
    "geolocation": {
      "type": "GeoPoint|null",
      "source": "geodata"
    },
    "elevationM": {
      "type": "number|null",
      "source": "reported|DEM_estimated"
    },
    "description": {
      "type": "string|null",
      "source": "licensed_or_original"
    },
    "grade": {
      "type": "Grade|null",
      "source": "explicit_only"
    },
    "gradeMandatory": {
      "type": "Grade|null",
      "source": "explicit_only"
    },
    "pitchesCount": {
      "type": "integer|null",
      "source": "explicit_only"
    },
    "boltsCount": {
      "type": "integer|null",
      "source": "explicit_only",
      "definition": "protezione fissa intermedia riportata dalla fonte; non includere la sosta salvo indicazione"
    },
    "quickdrawsRecommended": {
      "type": "integer|null",
      "source": "explicit_only",
      "mayInferFrom": [],
      "warning": "NEVER derive from boltsCount"
    },
    "boltingType": {
      "type": "enum|null",
      "values": [
        "bolts",
        "glue_in",
        "pitons",
        "trad",
        "mixed",
        "none",
        "unknown"
      ],
      "source": "explicit_only"
    },
    "anchorType": {
      "type": "string|null",
      "source": "explicit_only"
    },
    "ropeLengthRecommendedM": {
      "type": "number|null",
      "source": "explicit_only"
    },
    "routeLengthM": {
      "type": "number|null",
      "source": "explicit_only"
    },
    "pitchLengthM": {
      "type": "number|null",
      "source": "explicit_only"
    },
    "gearRequired": {
      "type": "string[]|null",
      "source": "explicit_only"
    },
    "restriction": {
      "type": "Restrictions[]",
      "source": "official_or_documented",
      "needsValidDate": true
    },
    "weather": {
      "type": "TimeSeries|null",
      "source": "meteo_api",
      "mustHave": "timestamp,units,altitude"
    },
    "photo": {
      "type": "Media[]",
      "source": "licensed",
      "mustHave": "author,source,licence"
    },
    "climbingRock": {
      "type": "string|null",
      "source": "OSM|openbeta|verified"
    },
    "orientation": {
      "type": "string|null",
      "source": "OSM|verified"
    }
  },
  "entityFields": {
    "municipality": [
      "name",
      "aliases",
      "geolocation",
      "elevationM",
      "population",
      "populationYear",
      "municipalityCode",
      "mayor",
      "mayorMandate",
      "history",
      "toponymy",
