  "sourceMapping": {
    "OSM": {
      "grade": "climbing:grade:french|climbing:grade:uiaa|climbing:grade:font",
      "pitchesCount": "climbing:pitches",
      "boltsCount": "climbing:bolts (numeric only)",
      "routeLengthM": "climbing:length",
      "orientation": "climbing:orientation",
      "rock": "climbing:rock",
      "quickdrawsRecommended": null
    },
    "OpenBeta": {
      "grade": "grades.french|grades.yds|grades.vscale",
      "boltsCount": "boltsCount",
      "routeLengthM": "length",
      "firstAscent": "fa",
      "quickdrawsRecommended": null,
      "pitchesCount": null
    }
  }
}
