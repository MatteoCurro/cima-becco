{
  "schemaVersion": "1.0",
  "canonicalSpec": "docs/MODELLO_METADATI_E_LAYOUT.md sections 1 and 5",
  "kind": "natural_feature",
  "status": "G0_G1_staging_only",
  "subtypes": [
    {
      "type": "mountain_pass",
      "evidence": "OSM mountain_pass=yes",
      "meta": [
        "elevationM",
        "localNames",
        "routes_crossing",
        "road_status"
      ]
    },
    {
      "type": "saddle",
      "evidence": "OSM natural=saddle",
      "meta": [
        "elevationM",
        "routes_crossing"
      ]
    },
    {
      "type": "lake",
      "evidence": "OSM natural=water + water=lake",
      "meta": [
        "area",
        "depthM",
        "elevationM",
        "naturalOrigin"
      ]
    },
    {
      "type": "reservoir",
      "evidence": "OSM natural=water + water=reservoir",
      "meta": [
        "area",
        "depthM",
        "elevationM",
        "operator"
      ]
    },
    {
      "type": "valley",
      "evidence": "OSM natural=valley",
      "meta": [
        "watercourses",
        "communities",
        "lengthKm",
        "routes"
      ]
    },
    {
      "type": "waterfall",
      "evidence": "OSM waterway=waterfall",
      "meta": [
        "waterfallDropM",
        "seasonalFlow",
        "viewpoints",
        "access"
      ]
    },
    {
      "type": "viewpoint",
      "evidence": "OSM tourism=viewpoint + name",
      "meta": [
        "orientation",
        "views",
        "photographs"
      ]
    }
  ],
  "waterReuse": {
    "existing": "public/data/alpine-water.json",
    "importer": "scripts/import_alpine_water.py",
    "rule": "spring and drinking_water remain in existing water importer; availability is not potability; never reimport duplicate physical points"
  },
  "sourceCandidates": [
    {
      "id": "osm",
      "status": "pilot",
      "license": "ODbL 1.0",
      "content": "stable OSM ID, name, typed tags and representative coordinate",
      "schedule": "small cells and provider-friendly refresh"
    },
    {
      "id": "wikidata",
      "status": "future",
      "content": "QID verified independent location, alternative names, photos"
    },
    {
      "id": "geonames",
      "status": "future",
      "content": "PASS LK VAL FLLS feature codes, separate ID reconciliation"
    },
    {
      "id": "regional_geoportal",
      "status": "future",
      "content": "lake polygons, boundaries, official elevation and protection"
    },
    {
      "id": "commons",
      "status": "future",
      "content": "subject-verified photos and historical media with author/license"
    },
    {
      "id": "cai_sat",
      "status": "future",
      "content": "confirmed pass crossing and route access"
    },
    {
      "id": "regional_meteo",
      "status": "future",
      "content": "closures, restrictions, seasonal flow; separate TTL"
    }
  ],
  "verifiedNow": [
    "id uuid5 from OSM source ID",
    "kind/subtype",
    "displayName",
    "geo.point",
    "sourceIds.osm",
    "elevationM if explicit ele",
    "waterfallDropM if explicit height",
    "localNames if explicit OSM tagged",
    "facts provenance fields",
    "near only with no access claims"
  ],
  "pendingG2": [
    "verify Wikidata QID and names",
    "verify polygon geometry for lakes/valleys",
    "verify media P18 or authorized official images",
    "source-backed informative text",
    "canonical/legacy URL policy",
    "SEO+frontend adapters",
    "quality checks against published atlas",
    "verified access/routes for mountain passes"
  ],
  "negativeGuarantees": [
    "No raw nearest water assumed potable",
    "No lake centroid called a shore or polygon",
    "No pass open/closed status inferred",
    "No waterfall height used as altitude",
    "No near relation interpreted as reachable",
    "No unpublished G0/G1 SEO pages"
  ]
}
