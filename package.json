{
  "name": "cima-becco",
  "version": "0.1.0",
  "private": true,
  "description": "Atlante collaborativo delle montagne italiane basato su HillGPX",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/rebuild_peak_index.mjs --check && node scripts/check_chrome_css.mjs && tsc --noEmit && vite build && node scripts/build_seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data": "python scripts/build_data.py",
    "data:dem": "python scripts/fetch_dem.py",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "css:check": "node scripts/check_chrome_css.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "maplibre-gl": "^6.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
